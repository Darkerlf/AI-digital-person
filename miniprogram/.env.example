# WeChat DevTools: use the backend running on this Windows computer.
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Real-device debugging: replace the line above with this computer's current LAN IPv4 address.
# VITE_API_BASE_URL=http://172.27.35.118:8000/api

# WeChat DevTools uses the localhost fallback from src/config/assets.ts.
# For a real device, configure an HTTPS business domain registered in WeChat.
# VITE_DH_LIVE_GUIDE_URL=https://guide.example.com/runtime/index.html

# Production example: use registered HTTPS domains before uploading the mini program.
# VITE_API_BASE_URL=https://api.example.com/api
